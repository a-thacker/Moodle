# Copy to command-center/.env and fill in. Consumed by docker-compose and,
# through it, the backend. Never commit the real .env (it holds the DB
# password). Compose reads this file automatically from the directory it runs
# in.

# --- Application ---
APP_NAME=Command Center
ENVIRONMENT=development          # development | production
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_USER=commandcenter
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=commandcenter

# --- Notifications (ntfy) ---
# NTFY_SERVER=https://ntfy.sh
# Per-user topics are auto-generated (users.ntfy_topic) and shared from the
# People screen; NTFY_TOPIC / SIBLING_NTFY_TOPIC only seed existing accounts.

# --- Proactive AI notifications ---
# Off by default: the assistant nudges AI-enabled users on a timer via ntfy.
# Preview yours first (Settings → Proactive notifications) before enabling.
PROACTIVE_ENABLED=false
# PROACTIVE_INTERVAL_MINUTES=60    # how often the loop wakes up
# PROACTIVE_COOLDOWN_MINUTES=180   # min gap between nudges per user
# PROACTIVE_DEDUP_HOURS=24         # suppress identical nudges within this window
