# Copy to command-center/.env and fill in. Consumed by docker-compose and,
# through it, the backend. Never commit the real .env (it holds the DB
# password). Compose reads this file automatically from the directory it runs
# in.

# --- Application ---
APP_NAME=Command Center
ENVIRONMENT=development          # development | production
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_USER=commandcenter
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=commandcenter

# --- External service links (shown as rail tools when the user is granted them) ---
# A link tool is hidden until its URL is set. Point these at the public HTTPS
# hostnames (via Nginx Proxy Manager), not the raw container ports.
JELLYFIN_URL=https://jellyfin.athacker.cc
OTTERWIKI_URL=https://wiki.athacker.cc

# --- Notifications (ntfy) ---
# ntfy now carries only the occasional nudges (proactive AI, owner broadcast);
# the daily task reminders go over Web Push (below).
# NTFY_SERVER=https://ntfy.sh
# Per-user topics are auto-generated (users.ntfy_topic) and shared from the
# People screen; NTFY_TOPIC / SIBLING_NTFY_TOPIC only seed existing accounts.

# --- Web Push (PWA task notifications, VAPID) ---
# The daily task reminders (morning digest / timed alerts / midday & evening
# re-pings) are delivered to the installed PWA over Web Push. Generate a VAPID
# keypair once (e.g. `npx web-push generate-vapid-keys` or py_vapid). The PUBLIC
# key ships as a code default (safe to expose); set VAPID_PUBLIC_KEY here only
# to override it. The PRIVATE key is a SECRET — set it and never commit it.
# Leaving VAPID_PRIVATE_KEY empty disables Web Push (task reminders won't send).
# VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=change-me-the-private-key-paired-with-the-public-key
# VAPID_SUBJECT=mailto:athacker@southern.edu

# --- Proactive AI notifications ---
# Off by default: the assistant nudges AI-enabled users on a timer via ntfy.
# Preview yours first (Settings → Proactive notifications) before enabling.
PROACTIVE_ENABLED=false
# PROACTIVE_INTERVAL_MINUTES=60    # how often the loop wakes up
# PROACTIVE_COOLDOWN_MINUTES=180   # min gap between nudges per user
# PROACTIVE_DEDUP_HOURS=24         # suppress identical nudges within this window
