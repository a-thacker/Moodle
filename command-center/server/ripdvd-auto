#!/usr/bin/env bash
# Non-interactive DVD/Blu-ray movie ripper for the Command Center rip tool.
#
# Unlike ~/bin/ripdvd (which prompts), this takes everything up front via env
# and never blocks on input, so the CC rip-runner can drive it. Movies only.
#
#   RIP_TITLE   movie name, include the year, e.g. "Cars (2006)"   (required)
#   RIP_EXTRAS  extras | keep | delete   (default: extras)
#
# It rips every title with makemkvcon, then treats the LARGEST .mkv as the main
# movie (renamed to "<title>.mkv") and applies the extras policy to the rest.
set -euo pipefail

# Force a permissive umask so created dirs/files are group+world readable — the
# Jellyfin service user must be able to traverse the movie folder. (Never rely
# on the umask the runner happens to inherit.)
umask 022

MEDIA_ROOT="/srv/media"
MOVIE_ROOT="$MEDIA_ROOT/Movies"
DVD="disc:0"
DRIVE="/dev/sr0"

TITLE="${RIP_TITLE:-}"
EXTRAS="${RIP_EXTRAS:-extras}"

if [[ -z "${TITLE// /}" ]]; then
  echo "ERROR: RIP_TITLE is required." >&2
  exit 2
fi

# Never let the title escape the Movies folder.
SAFE_TITLE="${TITLE//\//-}"
SAFE_TITLE="${SAFE_TITLE#.}"
DEST="$MOVIE_ROOT/$SAFE_TITLE"

echo "=============================="
echo "   Command Center DVD Ripper"
echo "=============================="
echo "Movie:  $SAFE_TITLE"
echo "Extras: $EXTRAS"
echo "Into:   $DEST"
echo

# Rip into a hidden STAGING dir first (same filesystem as the library, so the
# final move is instant). Nothing reaches the library until the rip succeeds and
# is sorted — so a killed/failed rip can never leave raw partials for Jellyfin to
# scan as bogus "movies". The trap clears staging on any exit.
STAGING="$MOVIE_ROOT/.rip-staging.$$"
mkdir -p "$STAGING"
trap 'rm -rf "$STAGING"' EXIT

# Guard against a rip that wedges forever (e.g. a Blu-ray this drive can't
# decrypt, which pins a core with no output and locks the drive). The watchdog
# aborts only on a hard time cap (MAX_HOURS) — a real rip always finishes well
# under it. The no-progress ("stall") abort is OFF by default (STALL_MIN=0):
# makemkvcon legitimately stops writing for a long time while working around
# scratched/corrupt sectors, so a stall abort kills healthy rips.
MAX_HOURS="${RIP_MAX_HOURS:-6}"
STALL_MIN="${RIP_STALL_MINUTES:-0}"

echo ">> Ripping all titles with makemkvcon (hard cap ${MAX_HOURS}h$([ "$STALL_MIN" -gt 0 ] && echo "; stall abort ${STALL_MIN}m"))…"
echo
makemkvcon mkv "$DVD" all "$STAGING" &
MK_PID=$!

(
  waited=0; stall=0; last=-1
  max_min=$(( MAX_HOURS * 60 ))
  while kill -0 "$MK_PID" 2>/dev/null; do
    sleep 60
    waited=$(( waited + 1 ))
    cur=$(du -sb "$STAGING" 2>/dev/null | cut -f1); cur=${cur:-0}
    if [ "$cur" = "$last" ]; then stall=$(( stall + 1 )); else stall=0; last="$cur"; fi
    if [ "$STALL_MIN" -gt 0 ] && [ "$stall" -ge "$STALL_MIN" ]; then
      echo ">> No progress for ${STALL_MIN} min — aborting (RIP_STALL_MINUTES)." >&2
      kill -TERM "$MK_PID" 2>/dev/null; sleep 5; kill -KILL "$MK_PID" 2>/dev/null; break
    fi
    if [ "$waited" -ge "$max_min" ]; then
      echo ">> Hit the ${MAX_HOURS}h cap — aborting." >&2
      kill -TERM "$MK_PID" 2>/dev/null; sleep 5; kill -KILL "$MK_PID" 2>/dev/null; break
    fi
  done
) &
WATCH_PID=$!

# Capture makemkvcon's status without letting `set -e` abort the script first.
MK_RC=0
wait "$MK_PID" || MK_RC=$?
kill "$WATCH_PID" 2>/dev/null || true
wait "$WATCH_PID" 2>/dev/null || true

if [ "$MK_RC" -ne 0 ]; then
  echo
  echo "ERROR: makemkvcon did not finish cleanly (exit $MK_RC). Nothing added to the library." >&2
  echo ">> Ejecting disc…"
  eject "$DRIVE" 2>/dev/null || echo "(couldn't eject — remove the disc manually)"
  exit "$MK_RC"
fi

echo
echo ">> Rip finished. Sorting files…"

# Largest .mkv = the feature. Print "<size> <path>" so we can sort by size even
# when filenames contain spaces.
mapfile -t BYSIZE < <(find "$STAGING" -maxdepth 1 -type f -name '*.mkv' -printf '%s\t%p\n' | sort -rn)

if [[ ${#BYSIZE[@]} -eq 0 ]]; then
  echo "ERROR: no .mkv files were produced — is there a disc in the drive?" >&2
  eject "$DRIVE" || true
  exit 1
fi

# Promote into the library only now that the rip is complete. Largest title is
# the feature; everything left in staging is an extra.
mkdir -p "$DEST"
MAIN="${BYSIZE[0]#*$'\t'}"
TARGET="$DEST/$SAFE_TITLE.mkv"
mv -f "$MAIN" "$TARGET"
echo "Main movie: $(basename "$TARGET")"

shopt -s nullglob
for f in "$STAGING"/*.mkv; do
  case "$EXTRAS" in
    delete) echo "  delete extra: $(basename "$f")"; rm -f "$f" ;;
    keep)   echo "  keep extra:   $(basename "$f")"; mv -f "$f" "$DEST/" ;;
    *)      mkdir -p "$DEST/extras"; echo "  -> extras/:  $(basename "$f")"; mv -f "$f" "$DEST/extras/" ;;
  esac
done

echo
echo ">> Fixing permissions so Jellyfin can read the movie…"
# Match the media convention (group jellyfin, group/other readable). athacker is
# in the jellyfin group, so chgrp needs no root.
chgrp -R jellyfin "$DEST" 2>/dev/null || true
chmod -R a+rX "$DEST"

echo
echo ">> Ejecting disc…"
eject "$DRIVE" || echo "(couldn't eject — remove the disc manually)"

echo
echo "Done! '$SAFE_TITLE' is ready in Jellyfin."

# Phone notification (same topic as the original ~/bin/ripdvd). The Icon header
# brands it with the Command Center site favicon, matching the app's other pushes.
curl -s -H "Title: DVD Rip Complete" -H "Priority: default" \
  -H "Icon: https://athacker.cc/android-chrome-192x192.png" \
  -d "$SAFE_TITLE has finished ripping. Ready for post-processing." \
  "https://ntfy.sh/2prUsoVg7SXLfVX2E6yFweZq4" >/dev/null || true
